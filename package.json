{
  "name": "seraya",
  "version": "0.1.0",
  "private": true,
  "description": "Seraya — Indonesia-first automated wedding invitation platform.",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "audit:j2:live-evidence": "node scripts/audit-live-cross-template-evidence.mjs",
    "audit:p0-a1:workspace-performance": "node scripts/audit-workspace-performance-baseline.mjs",
    "audit:p0-a4:readiness": "node scripts/audit-readiness-aggregation-recovery.mjs",
    "audit:p0-a5:editor-runtime": "node scripts/audit-editor-runtime-recovery.mjs",
    "capture:thumbnails": "node scripts/capture-canonical-thumbnails.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migration:new": "supabase migration new",
    "db:migration:list": "supabase migration list --local",
    "db:test": "supabase test db",
    "db:types": "node scripts/generate-supabase-types.mjs",
    "test:db": "vitest run tests/integration/supabase-foundation.test.ts tests/integration/guest-follow-up-foundation.test.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:invitation-experience": "playwright test --config=playwright.invitation-experience.config.ts",
    "e2e:visual-qa": "playwright test --config=playwright.visual-qa.config.ts",
    "e2e:personal-response": "playwright test --config=playwright.personal-response.config.ts",
    "e2e:ui": "playwright test --ui",
    "test:ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check": "npm run format:check && npm run test:ci"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.2.6",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "exceljs": "4.4.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "supabase": "2.107.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
